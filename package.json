{
  "name": "com.pear.desktop.streamdeck",
  "version": "1.0.0",
  "type": "module",
  "main": "bin/plugin.js",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.pear.desktop.streamdeck\"",
    "validate": "streamdeck validate com.pear.desktop.streamdeck.sdPlugin",
    "pack": "npm run build && streamdeck pack com.pear.desktop.streamdeck.sdPlugin"
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@elgato/cli": "^1.9.0",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^15.2.0",
    "@rollup/plugin-terser": "^0.4.0",
    "@rollup/plugin-typescript": "^12.0.0",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.0",
    "rollup": "^4.20.0",
    "typescript": "^5.5.0"
  }
}